# =============================================================================
# ai-powered — .gitignore
# =============================================================================

# =============================================================================
# DEPENDENCIES & BUILD
# =============================================================================

node_modules/
dist/
dist-web/
*.tsbuildinfo

# =============================================================================
# ENVIRONMENT & SECRETS  (NEVER commit credentials)
# =============================================================================

.env
.env.local
.env.*.local
.ai-powered/config.json
.ai-powered/config.json.bak.*

# =============================================================================
# RUNTIME LOGS & SESSION DATA
# =============================================================================

logs/
ai-powered.jsonl
ai-powered-audit.jsonl

# =============================================================================
# TESTING & COVERAGE
# =============================================================================

coverage/
.nyc_output/

# =============================================================================
# WIP / INTERNAL MATERIALS  (not for public repo)
# =============================================================================

# Marketing, sales, investor, and business-plan materials
marketing/

# Prompt-engineering artifacts and JIRA drafts
ai-prompts/

# Internal AI agent skills / instructions
.agents/

# Root-level WIP prompt files
TOC-prompt.md

# Beads task tracker data (local issue store + archive)
.beads/
completed.jsonl
scripts/completed.jsonl

# Internal / debug scripts (prefixed with underscore)
scripts/_*.ps1

# OpenSpec workflow artifacts (internal change management)
openspec/

# =============================================================================
# AUGMENT / TOOLING INTERNALS
# =============================================================================

# Augment Extensions manifest (machine-generated, local only)
.augment/extensions.json

# Dolt database files (added by bd init)
.dolt/
*.db

# Husky internal hooks
.husky/_/

# =============================================================================
# OS & EDITOR NOISE
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code (keep settings.json if team-shared, ignore personal state)
.vscode/settings.json
.vscode/*.code-workspace
.history/

# JetBrains IDEs
.idea/
*.iml

# Vim / Emacs swap files
*.swp
*.swo
*~

