# =============================================================================
# ai-powered – environment variable reference
# Copy this file to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# --- Provider API Keys ---
# Obtain from: https://platform.openai.com/account/api-keys
# OPENAI_API_KEY=sk-...

# Obtain from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Obtain from: https://console.x.ai/
# XAI_API_KEY=xai-...

# Obtain from: https://venice.ai/settings/api
# Note: Venice.ai uses an OpenAI-compatible API. Set the base URL below.
# VENICE_API_KEY=ven-...
# VENICE_BASE_URL=https://api.venice.ai/api/v1

# --- Provider Selection ---
# Which provider to use by default.
# Allowed values: openai | anthropic | xai | venice | custom | mock
# AI_PROVIDER=openai

# --- Model Selection ---
# Model identifier to use. Provider-specific. Overrides the provider default.
# Examples: gpt-4o, claude-3-5-sonnet-20241022, grok-2, venice-uncensored
# AI_MODEL=gpt-4o

# --- Named Profile ---
# The named profile to load from ~/.ai-powered/config.json or ./.ai-powered/config.json.
# Profiles are stored under the "profiles" key in the config file.
# AI_PROFILE=default

# --- Mock Mode ---
# Set to "true" to use MockProvider for all requests. No API keys required.
# Required in CI. All modalities return deterministic fixture responses.
# AI_MOCK=false

# --- Output Formatting ---
# Set to "1" to disable all ANSI color codes in CLI output.
# Equivalent to passing --no-color on every invocation.
# NO_COLOR=

# --- Custom / Ollama Provider ---
# When AI_PROVIDER=custom, set the base URL and optional headers.
# AI_CUSTOM_BASE_URL=http://localhost:11434/v1
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_TYPE=ollama

# --- Logging ---
# Log level: trace | debug | info | warn | error. Default: info.
# LOG_LEVEL=info

# --- Session Budget ---
# Maximum cumulative USD spend per CLI session before BudgetExceededError is thrown.
# AI_BUDGET_SESSION=1.00

# --- Budget Warning Threshold ---
# Fraction of budgetSession (0–1) at which a WARNING is emitted.
# AI_WARN_BUDGET=0.8

